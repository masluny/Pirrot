#!/usr/bin/env python3
import atexit
import json
import os
import re
import shutil
import socket
import sys
import time
from datetime import datetime, timezone

KEYS_FILE = os.path.expanduser("~/.pi/nvidia_keys.txt")
STATE_FILE = os.path.expanduser("~/.pi/nvidia_keys_state.json")
PROXY_HOST = "127.0.0.1"
PROXY_PORT = 8765
REFRESH = 1  # seconds between refreshes
DEFAULT_BUDGET = 1000

_ANSI_RE = re.compile(r"\033\[[0-9;]*m")

# Color constants. Disabled (set to "") when stdout is not a real terminal so
# piped output stays clean.
USE_COLOR = sys.stdout.isatty()
DIM = "\033[90m" if USE_COLOR else ""
RST = "\033[0m" if USE_COLOR else ""
BOLD_WHITE = "\033[1;97m" if USE_COLOR else ""
GREEN = "\033[1;32m" if USE_COLOR else ""
RED = "\033[1;31m" if USE_COLOR else ""
YELLOW = "\033[1;33m" if USE_COLOR else ""
DIM_YELLOW = "\033[33m" if USE_COLOR else ""
DIM_RED = "\033[31m" if USE_COLOR else ""


def parse_key_line(line):
    """Shared parse rule with the rotator: first whitespace token is the key,
    optional `budget=N`. Returns (key, budget) or None for blank/comment."""
    line = line.strip()
    if not line or line.startswith("#"):
        return None
    parts = line.split()
    key = parts[0]
    budget = DEFAULT_BUDGET
    for tok in parts[1:]:
        if tok.startswith("budget="):
            try:
                budget = int(tok.split("=", 1)[1])
            except ValueError:
                pass
    return key, budget


def load_keys():
    if not os.path.exists(KEYS_FILE):
        return [], {}
    keys, budgets = [], {}
    with open(KEYS_FILE) as fh:
        for line in fh:
            parsed = parse_key_line(line)
            if parsed:
                keys.append(parsed[0])
                budgets[parsed[0]] = parsed[1]
    return keys, budgets


def load_state():
    # Read-only: the rotator proxy owns the state file. Mutating it from here
    # raced with the proxy's writes and clobbered live counters.
    if os.path.exists(STATE_FILE):
        try:
            return json.load(open(STATE_FILE))
        except Exception:
            pass
    return {"keys": {}}


def proxy_up():
    """Cheap liveness probe: try to connect to the proxy port and close."""
    try:
        with socket.create_connection((PROXY_HOST, PROXY_PORT), timeout=0.2):
            return True
    except OSError:
        return False


def mask(k):
    return k[:4] + "..." + k[-4:] if len(k) > 10 else "***"


def fmt_countdown(until, now):
    if not until or until <= now:
        return ""
    secs = int(until - now)
    h, rem = divmod(secs, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h {m:02d}m {s:02d}s"
    if m:
        return f"{m}m {s:02d}s"
    return f"{s}s"


def fmt_reset_time(until):
    if not until:
        return "-"
    # Local time (Kacper is UTC+2 in summer) with UTC in parens.
    local = datetime.fromtimestamp(until).strftime("%H:%M:%S")
    utc = datetime.fromtimestamp(until, tz=timezone.utc).strftime("%H:%MZ")
    return f"{local} ({utc})"


def fmt_credits(used, budget):
    if not budget:
        return "-"
    pct = int(round(100 * used / budget)) if budget else 0
    return f"{used}/{budget} {pct}%"


def fmt_age(last_used, now):
    if not last_used:
        return "-"
    secs = int(max(0, now - last_used))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    return f"{secs // 3600}h"


def visible_len(text):
    return len(_ANSI_RE.sub("", text))


def pad(text, width, align="<"):
    """Pad text to width ignoring ANSI escape sequences."""
    padding = max(0, width - visible_len(text))
    if align == ">":
        return " " * padding + text
    return text + " " * padding


def truncate(text, width):
    """Truncate a rendered line to `width` visible columns, preserving ANSI."""
    if visible_len(text) <= width:
        return text
    out, count = [], 0
    i = 0
    while i < len(text) and count < width:
        m = _ANSI_RE.match(text, i)
        if m:
            out.append(m.group(0))
            i = m.end()
            continue
        out.append(text[i])
        count += 1
        i += 1
    out.append(RST)
    return "".join(out)


# Previous totals, for the rolling burn-rate readout.
_prev = {"t": None, "req": 0, "in": 0, "out": 0, "req_rate": 0.0, "tok_rate": 0.0}


def render(keys, budgets, state, now, proxy_alive):
    cols = shutil.get_terminal_size((100, 24)).columns
    lines = []

    # header
    ts = datetime.now().strftime("%H:%M:%S")
    hdr = f"  NVIDIA API Keys  —  {ts}  —  refreshing every {REFRESH}s  (q to quit)"
    lines.append(f"{BOLD_WHITE}{hdr}{RST}")

    # proxy liveness banner — the most common real failure (proxy down after a
    # reboot) is otherwise invisible because everything reads from the state file.
    if proxy_alive:
        lines.append(f"  {GREEN}● proxy: up{RST}  {DIM}(127.0.0.1:{PROXY_PORT}){RST}")
    else:
        lines.append(f"  {RED}● PROXY DOWN — run `pi-nvidia serve`{RST}")
    lines.append("")

    # column header
    head = (
        f"  {DIM}{'#':>2}{RST}"
        f"  {DIM}{'Key':<14}{RST}"
        f"  {DIM}{'Status':<9}{RST}"
        f"  {DIM}{'Reqs':>5}{RST}"
        f"  {DIM}{'In Tok':>8}{RST}"
        f"  {DIM}{'Out Tok':>8}{RST}"
        f"  {DIM}{'Errors':>6}{RST}"
        f"  {DIM}{'Credits':<12}{RST}"
        f"  {DIM}{'Age':>4}{RST}"
        f"  {DIM}{'Resets At':<18}{RST}"
        f"  {DIM}{'Timer':<13}{RST}"
        f"  {DIM}{'Reason'}{RST}"
    )
    lines.append(head)
    sep_len = min(cols - 4, 140)
    lines.append(f"  {DIM}{chr(9472) * sep_len}{RST}")

    total_req = total_in = total_out = total_err = 0
    avail = 0

    for i, k in enumerate(keys):
        ks = state.get("keys", {}).get(k, {})
        until = ks.get("rate_limited_until", 0)

        # display expired limits as available (the proxy clears the flag
        # itself the next time it picks a key; counters stay cumulative)
        if until and until <= now:
            until = 0

        active = not until or until <= now
        reqs = ks.get("requests", 0)
        intok = ks.get("input_tokens", 0)
        outtok = ks.get("output_tokens", 0)
        errors = ks.get("errors", 0)
        reason = ks.get("reset_reason", "") if not active else ""
        budget = budgets.get(k, DEFAULT_BUDGET)
        total_req += reqs
        total_in += intok
        total_out += outtok
        total_err += errors

        if active:
            avail += 1
            status_str = f"{GREEN}● ACTIVE {RST}"
            timer_str = f"{DIM}-{RST}"
            reset_str = f"{DIM}-{RST}"
        else:
            status_str = f"{RED}○ LIMITED{RST}"
            cd = fmt_countdown(until, now)
            timer_str = f"{YELLOW}⏱ {cd}{RST}"
            reset_str = f"{DIM_YELLOW}{fmt_reset_time(until)}{RST}"

        # credits colored yellow when burning past 80% of budget
        cred_txt = fmt_credits(reqs, budget)
        if budget and reqs / budget > 0.8:
            cred_str = f"{YELLOW}{cred_txt}{RST}"
        else:
            cred_str = f"{DIM}{cred_txt}{RST}"

        err_str = f"{DIM_RED}{errors}{RST}" if errors else f"{DIM}{errors}{RST}"
        reason_str = f"{DIM}{reason}{RST}" if reason else ""
        age_str = fmt_age(ks.get("last_used", 0), now)

        line = (
            f"  {i:>2}"
            f"  {mask(k):<14}"
            f"  {pad(status_str, 9)}"
            f"  {reqs:>5}"
            f"  {intok:>8}"
            f"  {outtok:>8}"
            f"  {pad(err_str, 6, '>')}"
            f"  {pad(cred_str, 12)}"
            f"  {age_str:>4}"
            f"  {pad(reset_str, 18)}"
            f"  {pad(timer_str, 13)}"
            f"  {reason_str}"
        )
        lines.append(truncate(line, cols))

    lines.append(f"  {DIM}{chr(9472) * sep_len}{RST}")

    # totals (now including the Errors column)
    lines.append(
        f"  {BOLD_WHITE}{'':>2}  {'TOTAL':<14}  {'':9}"
        f"  {total_req:>5}  {total_in:>8}  {total_out:>8}  {total_err:>6}{RST}"
    )
    lines.append("")

    # rolling burn rate (req/min, tok/min) computed across refreshes
    req_rate, tok_rate = _prev["req_rate"], _prev["tok_rate"]
    if _prev["t"] is not None:
        dt = now - _prev["t"]
        if dt > 0:
            inst_req = max(0, total_req - _prev["req"]) / dt * 60
            inst_tok = max(0, (total_in + total_out) - (_prev["in"] + _prev["out"])) / dt * 60
            # light smoothing so the number is readable
            req_rate = 0.7 * _prev["req_rate"] + 0.3 * inst_req
            tok_rate = 0.7 * _prev["tok_rate"] + 0.3 * inst_tok
    _prev.update({"t": now, "req": total_req, "in": total_in, "out": total_out,
                  "req_rate": req_rate, "tok_rate": tok_rate})
    lines.append(
        f"  {DIM}burn: {req_rate:5.1f} req/min   {tok_rate:7.0f} tok/min{RST}"
    )

    # summary bar
    n = len(keys)
    bar_color = GREEN if avail == n else (YELLOW if avail > 0 else RED)
    lines.append(f"  {bar_color}▸ {avail}/{n} keys available{RST}"
                 f"   {DIM}│  state: {STATE_FILE}{RST}")
    lines.append("")

    return lines


def print_frame(lines, clear_below=True):
    """Home the cursor and repaint each line with erase-to-end-of-line, then
    erase below — no full-screen clear, so it doesn't flicker."""
    out = ["\033[H"] if USE_COLOR else []
    for ln in lines:
        out.append(ln + ("\033[K" if USE_COLOR else ""))
    body = "\n".join(out)
    if clear_below and USE_COLOR:
        body += "\n\033[J"
    print(body, end="", flush=True)


def main():
    one_shot = not sys.stdout.isatty() or not sys.stdin.isatty() or "--once" in sys.argv

    if one_shot:
        keys, budgets = load_keys()
        if not keys:
            print("No NVIDIA keys configured.")
            return
        state = load_state()
        now = time.time()
        print("\n".join(render(keys, budgets, state, now, proxy_up())))
        return

    # interactive live mode
    import select
    import termios
    import tty

    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    def restore_cursor():
        # Runs on normal exit AND on SIGTERM/atexit so the cursor never stays
        # hidden.
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()

    atexit.register(restore_cursor)

    try:
        tty.setcbreak(fd)
        print("\033[2J\033[H\033[?25l", end="")  # clear once, home, hide cursor

        while True:
            keys, budgets = load_keys()
            now = time.time()
            if not keys:
                print_frame(["  No NVIDIA keys configured."])
            else:
                state = load_state()
                print_frame(render(keys, budgets, state, now, proxy_up()))

            # wait for REFRESH seconds, but check for keypress to quit
            deadline = time.time() + REFRESH
            while True:
                remaining = deadline - time.time()
                if remaining <= 0:
                    break
                ready, _, _ = select.select([sys.stdin], [], [], min(remaining, 0.1))
                if ready:
                    ch = sys.stdin.read(1)
                    if ch in ("q", "Q", "\x03", "\x1b"):  # q, Ctrl-C, Esc
                        return
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        restore_cursor()
        print()


if __name__ == "__main__":
    main()
